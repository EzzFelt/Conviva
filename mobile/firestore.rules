rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /institutions/{institutionId} {
      // O cadastro consulta a instituição antes de criar a conta.
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && (
        (
          request.resource.data.type == 'idoso' &&
          request.resource.data.name is string &&
          request.resource.data.phone is string &&
          request.resource.data.elderLinkCode is string &&
          request.resource.data.institutionId is string &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdAt is timestamp
        ) || (
          request.resource.data.type in ['family', 'caregiver'] &&
          request.resource.data.name is string &&
          request.resource.data.email is string &&
          request.resource.data.phone is string &&
          request.resource.data.institutionId is string &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdAt is timestamp
        )
      );

      // Mantém compatibilidade com as consultas atuais do app.
      // Quando as consultas incluírem a instituição, esta leitura poderá
      // ser restringida por instituição e vínculo.
      allow read: if signedIn();

      allow update: if isOwner(userId) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'phone', 'email']);

      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      function isChatParticipant() {
        return signedIn() &&
          resource.data.participants.hasAny([request.auth.uid]) &&
          resource.data.institutionId ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.institutionId;
      }

      function isChatParticipantOnCreate() {
        return signedIn() &&
          request.resource.data.participants.hasAny([request.auth.uid]) &&
          request.resource.data.institutionId ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.institutionId;
      }

      allow get: if !exists(
        /databases/$(database)/documents/chats/$(chatId)
      ) || isChatParticipant();
      allow list: if isChatParticipant();
      allow create: if isChatParticipantOnCreate() &&
        request.resource.data.chatId == chatId &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participantsData is map &&
        request.resource.data.unreadCount is map;
      allow update: if isChatParticipant() &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.institutionId == resource.data.institutionId;
      allow delete: if false;

      match /messages/{messageId} {
        function isParentChatParticipant() {
          return signedIn() &&
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants.hasAny([request.auth.uid]) &&
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.institutionId ==
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.institutionId;
        }

        allow get, list: if !exists(
          /databases/$(database)/documents/chats/$(chatId)
        ) || isParentChatParticipant();
        allow create: if isParentChatParticipant() &&
          request.resource.data.messageId == messageId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.type in ['text', 'image', 'audio'] &&
          request.resource.data.readBy is list &&
          request.resource.data.createdAt is timestamp;
        allow update: if isParentChatParticipant() &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.messageId == resource.data.messageId &&
          request.resource.data.readBy.hasOnly(
            resource.data.readBy.concat([request.auth.uid])
          );
        allow delete: if false;
      }
    }

    match /familyLinks/{linkId} {
      allow create: if
        signedIn() &&
        request.resource.data.familiarId == request.auth.uid &&
        request.resource.data.elderId is string &&
        request.resource.data.institutionId is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt is timestamp &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.type == 'family' &&
        get(
          /databases/$(database)/documents/users/$(request.resource.data.elderId)
        ).data.type == 'idoso' &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.institutionId == request.resource.data.institutionId &&
        get(
          /databases/$(database)/documents/users/$(request.resource.data.elderId)
        ).data.institutionId == request.resource.data.institutionId;

      allow read: if
        signedIn() &&
        (
          request.auth.uid == resource.data.familiarId ||
          request.auth.uid == resource.data.elderId
        );

      allow update, delete: if
        signedIn() &&
        request.auth.uid == resource.data.familiarId;
    }

    match /auriChats/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
