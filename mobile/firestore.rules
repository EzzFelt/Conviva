rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /institutions/{institutionId} {
      // O cadastro consulta a instituição antes de criar a conta.
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && (
        (
          request.resource.data.type == 'idoso' &&
          request.resource.data.name is string &&
          request.resource.data.phone is string &&
          request.resource.data.elderLinkCode is string &&
          request.resource.data.institutionId is string &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdAt is timestamp
        ) || (
          request.resource.data.type in ['family', 'caregiver'] &&
          request.resource.data.name is string &&
          request.resource.data.email is string &&
          request.resource.data.phone is string &&
          request.resource.data.institutionId is string &&
          request.resource.data.status == 'active' &&
          request.resource.data.createdAt is timestamp
        )
      );

      // Mantém compatibilidade com as consultas atuais do app.
      // Quando as consultas incluírem a instituição, esta leitura poderá
      // ser restringida por instituição e vínculo.
      allow read: if signedIn();

      allow update: if isOwner(userId) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'phone', 'email']);

      allow delete: if isOwner(userId);
    }

    match /familyLinks/{linkId} {
      allow create: if
        signedIn() &&
        request.resource.data.familiarId == request.auth.uid &&
        request.resource.data.elderId is string &&
        request.resource.data.institutionId is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt is timestamp &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.type == 'family' &&
        get(
          /databases/$(database)/documents/users/$(request.resource.data.elderId)
        ).data.type == 'idoso' &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.institutionId == request.resource.data.institutionId &&
        get(
          /databases/$(database)/documents/users/$(request.resource.data.elderId)
        ).data.institutionId == request.resource.data.institutionId;

      allow read: if
        signedIn() &&
        (
          request.auth.uid == resource.data.familiarId ||
          request.auth.uid == resource.data.elderId
        );

      allow update, delete: if
        signedIn() &&
        request.auth.uid == resource.data.familiarId;
    }
  }
}
